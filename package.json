{
  "name": "@obergodmar/scrollbar",
  "version": "1.1.0",
  "license": "MIT",
  "author": "Vitaly Kogogin <obergodmar@gmail.com>",
  "description": "A small React library that replaces the SimpleBar functionality",
  "keywords": [
    "react",
    "scrollbar",
    "ui",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/obergodmar/scrollbar"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com/"
  },
  "bugs": "https://github.com/obergodmar/scrollbar/issues",
  "homepage": "https://github.com/obergodmar/scrollbar",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite dev",
    "ssr": "node server.mjs",
    "clean": "rimraf --glob dist",
    "compile": "tsc --build --clean && tsc --build --force",
    "postcss": "cross-env NODE_ENV=production postcss './src/**/*.css' --base ./src/scrollbar/ --dir ./dist/ --no-map",
    "build": "pnpm run clean && pnpm run compile && tsc-alias && pnpm run postcss",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.8",
    "cssnano-preset-lite": "^4.0.6",
    "eslint": "^10.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.13",
    "postcss-cli": "^11.0.1",
    "postcss-prefixer": "^3.0.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
